  <script>
    // --- WEB AUDIO SYNTHESIZER (Zero External MP3 Files Needed!) ---
    let audioCtx = null;
    function unlockAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === "suspended") {
        audioCtx.resume();
      }
    }

    // Upward happy chime when Shopkeeper marks order "Ready for Pickup"
    function playStudentReadySound() {
      unlockAudio();
      const now = audioCtx.currentTime;
      [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(freq, now + idx * 0.11);
        gain.gain.setValueAtTime(0.25, now + idx * 0.11);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.11 + 0.3);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now + idx * 0.11);
        osc.stop(now + idx * 0.11 + 0.32);
      });
    }

    // Low double alert tone when Shopkeeper marks item "Out of Stock / Rejected"
    function playStudentRejectedSound() {
      unlockAudio();
      const now = audioCtx.currentTime;
      [300, 220].forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(freq, now + idx * 0.22);
        gain.gain.setValueAtTime(0.2, now + idx * 0.22);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.22 + 0.25);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now + idx * 0.22);
        osc.stop(now + idx * 0.22 + 0.27);
      });
    }

    // Quick pop sound when student clicks Reserve
    function playClickConfirmSound() {
      unlockAudio();
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(600, now);
      osc.frequency.exponentialRampToValueAtTime(900, now + 0.12);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.16);
    }

    let toastTimer = null;
    function showToast(msg) {
      const box = document.getElementById("liveToast");
      box.innerText = msg;
      box.classList.remove("hidden");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => box.classList.add("hidden"), 4500);
    }

    const BASE_CATALOG = [
      { id: 1, shop: "General Shop", category: "Stationery", name: "Practical File / Lab Manual", price: 65, defaultStatus: "In Stock" },
      { id: 2, shop: "General Shop", category: "Stationery", name: "A4 Assignment Sheets (50 Pack)", price: 45, defaultStatus: "In Stock" },
      { id: 3, shop: "General Shop", category: "Service", name: "Instant B&W Printout / Xerox", price: 2, defaultStatus: "In Stock" },
      { id: 4, shop: "General Shop", category: "Engineering", name: "Mini Drafter & Graph Sheet Set", price: 180, defaultStatus: "Low Stock" },
      { id: 5, shop: "General Shop", category: "Dairy", name: "Amul Gold Tetra Milk (1 Litre)", price: 72, defaultStatus: "In Stock" },
      { id: 6, shop: "General Shop", category: "Hostel Need", name: "Maggi 4-Pack (For Room Kettle)", price: 56, defaultStatus: "In Stock" },
      { id: 7, shop: "Day Canteen", category: "Hot Snack", name: "Baked Aloo Patties", price: 20, defaultStatus: "In Stock" },
      { id: 8, shop: "Day Canteen", category: "Beverage", name: "Thick Cold Coffee", price: 35, defaultStatus: "In Stock" },
      { id: 9, shop: "Day Canteen", category: "Hot Snack", name: "Crispy Samosa (2 Pcs) + Chhole", price: 30, defaultStatus: "Low Stock" },
      { id: 10, shop: "Day Canteen", category: "Beverage", name: "Fresh Nimbu Masala Soda", price: 20, defaultStatus: "In Stock" },
      { id: 11, shop: "Night Canteen", category: "Exam Staple", name: "Double Masala Cheese Maggi", price: 40, defaultStatus: "In Stock" },
      { id: 12, shop: "Night Canteen", category: "Protein", name: "Double Egg Bread Omelette", price: 35, defaultStatus: "In Stock" },
      { id: 13, shop: "Night Canteen", category: "Beverage", name: "Hot Kulhad Adrak Chai", price: 15, defaultStatus: "In Stock" },
      { id: 14, shop: "Night Canteen", category: "Tandoor", name: "Aloo Pyaaz Paratha with Curd", price: 35, defaultStatus: "In Stock" }
    ];

    const BHAWANS = [
      "Rajendra Bhawan (RJB)", "Rajiv Bhawan", "Ravindra Bhawan",
      "Cautley Bhawan", "Govind Bhawan", "Sarojini Bhawan", "Jawahar Bhawan"
    ];

    const SHOP_CONFIG = {
      "General Shop": {
        icon: "🛒", label: "General Shop", hoursText: "9:00 AM – 9:00 PM",
        desc: "Stationery, Lab Manuals, Printouts, Milk & Kettle Maggi",
        isOpen: (h) => h >= 9 && h < 21
      },
      "Day Canteen": {
        icon: "☀️", label: "Day Canteen", hoursText: "10:00 AM – 10:00 PM",
        desc: "Baked Patties, Cold Coffee, Samosa & Fresh Shikanji",
        isOpen: (h) => h >= 10 && h < 22
      },
      "Night Canteen": {
        icon: "🌙", label: "Night Canteen", hoursText: "10:00 PM – 2:00 AM",
        desc: "Late-Night Exam Maggi, Omelette, Paratha & Kulhad Chai",
        isOpen: (h) => h >= 22 || h < 2
      }
    };

    const STORAGE_KEY = "BHAWAN_PULSE_ISOLATED_V3";
    let mqttClient = null;
    let mqttTopic = "bhawanpulse/iitr/v3/IITR-SYNTAX-ERROR-2026";

    let appState = {
      stockByBhawanItem: {},
      crowdByShop: {},
      votesByShop: {},
      orders: []
    };

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) { try { appState = JSON.parse(saved); } catch(e){} }

    // Track previous order statuses so we can ring a sound when the Shopkeeper updates a student's order!
    let knownOrderStatuses = {};
    let student = null;
    let selectedBhawan = "Rajendra Bhawan (RJB)";
    let selectedShop = "General Shop";
    let simulatedHour = "real";
    let showHistory = false;

    function syncKnownOrderStatuses(ordersList) {
      ordersList.forEach(o => {
        knownOrderStatuses[o.orderId] = o.status;
      });
    }
    syncKnownOrderStatuses(appState.orders);

    function checkAndPlayStudentOrderAlert(incomingState) {
      if (!student) return;
      (incomingState.orders || []).forEach(o => {
        if (o.studentId === student.id) {
          const prevStatus = knownOrderStatuses[o.orderId];
          if (prevStatus && prevStatus !== o.status) {
            if (o.status.includes("Ready")) {
              playStudentReadySound();
              showToast(`🔔 DING! Order ${o.orderId} (${o.itemName}) is READY FOR PICKUP at ${o.bhawan}!`);
            } else if (o.status.includes("Cancelled")) {
              playStudentRejectedSound();
              showToast(`⚠️ Order ${o.orderId} (${o.itemName}) was cancelled — Out of Stock at ${o.bhawan}.`);
            }
          }
        }
        knownOrderStatuses[o.orderId] = o.status;
      });
    }

    function getItemStatus(bhawan, item) {
      const key = `${bhawan}__${item.id}`;
      return appState.stockByBhawanItem[key] || item.defaultStatus;
    }

    function getShopCrowd(bhawan, shop) {
      const key = `${bhawan}__${shop}`;
      return appState.crowdByShop[key] || "Normal";
    }

    function initCloudSync(roomCode) {
      mqttTopic = "bhawanpulse/iitr/v3/" + roomCode.trim();
      document.getElementById("roomDisplayBadge").innerText = "📡 Room: " + roomCode.trim();

      if (mqttClient) mqttClient.end();
      mqttClient = mqtt.connect("wss://broker.emqx.io:8084/mqtt");

      mqttClient.on("connect", () => {
        const badge = document.getElementById("cloudStatusBadge");
        badge.className = "badge badge-green";
        badge.innerText = "☁️ Multi-Laptop Sync LIVE";
        mqttClient.subscribe(mqttTopic, { qos: 1 });
      });

      mqttClient.on("message", (topic, message) => {
        if (topic === mqttTopic) {
          try {
            const incoming = JSON.parse(message.toString());
            checkAndPlayStudentOrderAlert(incoming);
            appState = incoming;
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            renderAll();
          } catch (err) {}
        }
      });
    }

    function broadcastStateUpdate() {
      syncKnownOrderStatuses(appState.orders);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      if (mqttClient && mqttClient.connected) {
        mqttClient.publish(mqttTopic, JSON.stringify(appState), { qos: 1, retain: true });
      }
      renderAll();
    }

    window.addEventListener("storage", () => {
      const s = localStorage.getItem(STORAGE_KEY);
      if (s) {
        const incoming = JSON.parse(s);
        checkAndPlayStudentOrderAlert(incoming);
        appState = incoming;
        renderAll();
      }
    });

    function getCurrentHour() {
      if (simulatedHour !== "real") return parseInt(simulatedHour, 10);
      return new Date().getHours();
    }

    function formatHourLabel() {
      if (simulatedHour === "real") {
        return "Live Clock: " + new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }
      const h = parseInt(simulatedHour, 10);
      if (h === 14) return "Simulated: 2:00 PM (Daytime)";
      if (h === 23) return "Simulated: 11:30 PM (Night Exam Hour)";
      return "Simulated: 4:00 AM (Late Night)";
    }

    function autoSelectOpenShop() {
      const h = getCurrentHour();
      if (SHOP_CONFIG["General Shop"].isOpen(h)) selectedShop = "General Shop";
      else if (SHOP_CONFIG["Day Canteen"].isOpen(h)) selectedShop = "Day Canteen";
      else if (SHOP_CONFIG["Night Canteen"].isOpen(h)) selectedShop = "Night Canteen";
    }

    function changeTimeSimulation(val) {
      simulatedHour = val;
      autoSelectOpenShop();
      renderAll();
    }

    function toggleTheme() {
      document.body.classList.toggle("dark");
      document.getElementById("themeBtn").innerText = document.body.classList.contains("dark") ? "☀️ Day" : "🌙 Dark";
    }

    function loginStudent() {
      unlockAudio();
      const name = document.getElementById("stuName").value.trim() || "IITR Student";
      const id = document.getElementById("stuId").value.trim();
      const bhawan = document.getElementById("stuBhawan").value;
      const roomCode = document.getElementById("roomCodeInput").value.trim() || "IITR-SYNTAX-ERROR-2026";

      if (!id.endsWith("@iitr.ac.in") && !/^\d{8}$/.test(id)) {
        alert("Access Denied: Only @iitr.ac.in emails or 8-digit IITR Enrollment Numbers allowed!");
        return;
      }

      student = { name, id, bhawan };
      selectedBhawan = bhawan;
      autoSelectOpenShop();
      initCloudSync(roomCode);

      document.getElementById("loginBox").classList.add("hidden");
      document.getElementById("appBox").classList.remove("hidden");
      document.getElementById("historyBtn").classList.remove("hidden");
      document.getElementById("logoutBtn").classList.remove("hidden");
      renderAll();
    }

    function logout() {
      student = null;
      document.getElementById("loginBox").classList.remove("hidden");
      document.getElementById("appBox").classList.add("hidden");
      document.getElementById("historyBtn").classList.add("hidden");
      document.getElementById("logoutBtn").classList.add("hidden");
    }

    function toggleHistory() {
      showHistory = !showHistory;
      document.getElementById("historyPanel").classList.toggle("hidden", !showHistory);
    }

    function voteCrowd(type) {
      playClickConfirmSound();
      const shopKey = `${selectedBhawan}__${selectedShop}`;
      if (!appState.votesByShop[shopKey]) {
        appState.votesByShop[shopKey] = { Normal: 0, Crowded: 0 };
      }
      appState.votesByShop[shopKey][type]++;
      const needed = 3 - appState.votesByShop[shopKey][type];

      if (needed <= 0) {
        appState.crowdByShop[shopKey] = type;
        appState.votesByShop[shopKey] = { Normal: 0, Crowded: 0 };
        document.getElementById("voteInfo").innerText = `✅ Verified by 3 students for ${selectedBhawan}!`;
      } else {
        document.getElementById("voteInfo").innerText = `⏳ Vote recorded (${appState.votesByShop[shopKey][type]}/3 needed for ${selectedBhawan})`;
      }
      broadcastStateUpdate();
    }

    function reserveItem(itemId) {
      const h = getCurrentHour();
      if (!SHOP_CONFIG[selectedShop].isOpen(h)) {
        alert(`Sorry! ${selectedShop} is only open during ${SHOP_CONFIG[selectedShop].hoursText}.`);
        return;
      }

      const product = BASE_CATALOG.find(p => p.id === itemId);
      const currentSt = getItemStatus(selectedBhawan, product);
      if (!product || currentSt === "Out of Stock") return;

      playClickConfirmSound();

      const shortCode = selectedBhawan.split(" ")[0].toUpperCase().slice(0, 4);
      const token = `#${shortCode}-` + Math.floor(100 + Math.random() * 900);
      const nowStr = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

      appState.orders.unshift({
        orderId: token,
        studentName: student.name,
        studentId: student.id,
        bhawan: selectedBhawan,
        shop: selectedShop,
        itemId: product.id,
        itemName: product.name,
        price: product.price,
        time: `Today, ${nowStr}`,
        status: "Pending Shopkeeper Approval"
      });

      broadcastStateUpdate();
      showToast(`✅ Order ${token} sent to ${selectedBhawan} (${selectedShop})!`);
    }

    function renderAll() {
      if (!student) return;
      const hour = getCurrentHour();

      document.getElementById("avatarChar").innerText = student.name.charAt(0).toUpperCase();
      document.getElementById("profName").innerText = student.name;
      document.getElementById("profMeta").innerText = `${student.id} • Home: ${student.bhawan}`;
      document.getElementById("liveClockBadge").innerText = "🕒 " + formatHourLabel();

      document.getElementById("bhawanBar").innerHTML = BHAWANS.map(b => `
        <button class="${b === selectedBhawan ? 'active' : ''}" onclick="selectedBhawan='${b}'; renderAll();">
          🏢 ${b}
        </button>
      `).join("");

      document.getElementById("shopTabsGrid").innerHTML = Object.keys(SHOP_CONFIG).map(key => {
        const cfg = SHOP_CONFIG[key];
        const openNow = cfg.isOpen(hour);
        return `
          <div class="shop-tab-card ${selectedShop === key ? 'active' : ''} ${!openNow ? 'closed-shop' : ''}"
               onclick="selectedShop='${key}'; renderAll();">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <h4>${cfg.icon} ${cfg.label}</h4>
              <span class="badge ${openNow ? 'badge-green' : 'badge-red'}">
                ${openNow ? '🟢 OPEN NOW' : '🔒 CLOSED'}
              </span>
            </div>
            <p style="font-size:0.8rem; font-weight:700;">🕒 ${cfg.hoursText}</p>
            <p style="font-size:0.76rem; color:var(--muted); margin-top:2px;">${cfg.desc}</p>
          </div>
        `;
      }).join("");

      const isSelectedShopOpen = SHOP_CONFIG[selectedShop].isOpen(hour);
      const closedBanner = document.getElementById("closedBanner");
      closedBanner.classList.toggle("hidden", isSelectedShopOpen);
      if (!isSelectedShopOpen) {
        document.getElementById("closedBannerText").innerText =
          `🔒 ${selectedBhawan} (${selectedShop}) is CLOSED right now (Active Hours: ${SHOP_CONFIG[selectedShop].hoursText}).`;
      }

      const currentCrowd = getShopCrowd(selectedBhawan, selectedShop);
      document.getElementById("shopHeading").innerText = `${selectedBhawan} — ${selectedShop}`;
      document.getElementById("shopSubTiming").innerText = `Assigned Hours: ${SHOP_CONFIG[selectedShop].hoursText} • Isolated Inventory`;
      const cBadge = document.getElementById("crowdBadge");
      cBadge.className = `badge ${currentCrowd === 'Normal' ? 'badge-green' : 'badge-red'}`;
      cBadge.innerText = currentCrowd === "Normal" ? "🟢 Khula Hai (Normal Crowd)" : "🔴 Heavy Exam Rush (15m+ wait)";

      const items = BASE_CATALOG.filter(p => p.shop === selectedShop);
      document.getElementById("itemsGrid").innerHTML = items.map(item => {
        const st = getItemStatus(selectedBhawan, item);
        let bClass = "badge-green";
        if (st === "Low Stock") bClass = "badge-yellow";
        if (st === "Out of Stock") bClass = "badge-red";

        let btnHTML = "";
        if (!isSelectedShopOpen) {
          btnHTML = `<button disabled style="width:100%; justify-content:center; opacity:0.5; cursor:not-allowed;">🔒 Shop Closed (${SHOP_CONFIG[selectedShop].hoursText})</button>`;
        } else if (st === "Out of Stock") {
          btnHTML = `<button disabled style="width:100%; justify-content:center; opacity:0.5; cursor:not-allowed;">🔴 Out of Stock at ${selectedBhawan.split(' ')[0]}</button>`;
        } else {
          btnHTML = `<button class="btn-primary" style="width:100%; justify-content:center;" onclick="reserveItem(${item.id})">⚡ Reserve at ${selectedBhawan.split(' ')[0]}</button>`;
        }

        return `
          <div class="item-card">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="item-category">${item.category}</span>
                <span class="badge ${bClass}">${st}</span>
              </div>
              <div class="item-title">${item.name}</div>
              <div class="item-price">₹${item.price}</div>
            </div>
            ${btnHTML}
          </div>
        `;
      }).join("");

      const myOrders = appState.orders.filter(o => o.studentId === student.id);
      document.getElementById("orderCount").innerText = myOrders.length;
      document.getElementById("historyList").innerHTML = myOrders.length === 0
        ? `<p style="color:var(--muted); margin-top:10px;">No orders placed yet.</p>`
        : myOrders.map(o => {
            let stClass = "badge-yellow";
            if (o.status.includes("Ready")) stClass = "badge-green";
            if (o.status.includes("Cancelled")) stClass = "badge-red";
            return `
              <div class="order-row">
                <div>
                  <strong>${o.orderId} — ${o.itemName} (₹${o.price})</strong>
                  <div style="font-size:0.8rem; color:var(--muted); margin-top:2px;">
                    📍 Routed to: <b>${o.bhawan} — ${o.shop}</b> • 🕒 ${o.time}
                  </div>
                </div>
                <span class="badge ${stClass}">${o.status}</span>
              </div>
            `;
          }).join("");
    }
  </script>
</body>
</html>
